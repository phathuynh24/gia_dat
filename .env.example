# Sao chép file này thành .env và điền key khi cần. App vẫn chạy được nếu để trống.

# Dùng cho parser nâng cao (parse tiếng Việt lộn xộn bằng Claude). Để trống -> parser dùng regex.
ANTHROPIC_API_KEY=

# Dùng cho geocoding địa chỉ -> lat/lng (heatmap, giai đoạn sau). Để trống -> bỏ qua geocoding.
GOOGLE_MAPS_API_KEY=
